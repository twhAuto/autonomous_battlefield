# Runtime Nginx server template serving the SPA, process health routes, and /v1 API proxy
# with DNS re-resolution.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location ~ ^/(startupz|livez|readyz|healthz)$ {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /v1/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $http_x_request_id;
    }

    # Revalidate the entry document so navigation after a rollout cannot retain
    # references to hashed assets removed by the new image.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
