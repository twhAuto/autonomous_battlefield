// AB-126: reviewed Terraform VM operations; guest K3s remains AB-128.
pipeline {
    agent { label 'battlefield-production' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }
    parameters {
        choice(name: 'ACTION', choices: ['plan', 'apply', 'verify'], description: 'Apply creates a fresh plan and pauses for owner review before changing the VM.')
        booleanParam(name: 'REPLACE_OS', defaultValue: false, description: 'Review an OS/domain replacement. Persistent data deletion remains forbidden.')
    }
    stages {
        stage('Trusted checkout') {
            steps {
                script {
                    if (env.JOB_NAME != 'battlefield-platform/vm' || env.CHANGE_ID) {
                        error('Run this entry point only in the seeded platform VM job.')
                    }
                    deleteDir()
                    def source = checkout scm
                    env.PLATFORM_REVISION = source.GIT_COMMIT
                    env.PLATFORM_PRIVATE = "${pwd(tmp: true)}/platform-${env.BUILD_NUMBER}"
                    sh 'umask 077; mkdir -p "$PLATFORM_PRIVATE"'
                }
            }
        }
        stage('VM operation') {
            steps {
                // Same resource as the main production rollout, including its smoke/recovery stages.
                lock(resource: 'battlefield-production-platform') {
                    withCredentials([
                        file(credentialsId: 'host-inventory', variable: 'PLATFORM_INVENTORY'),
                        file(credentialsId: 'host-vault-password', variable: 'PLATFORM_VAULT_PASSWORD'),
                        file(credentialsId: 'host-sudo-password', variable: 'PLATFORM_SUDO_PASSWORD')
                    ]) {
                        script {
                            def action = params.ACTION == 'verify' ? 'verify' : 'plan'
                            withEnv(["PLATFORM_ACTION=${action}", "VM_REPLACE_OS=${params.REPLACE_OS}"]) {
                                sh './scripts/ci/run-vm.sh'
                            }
                            archiveArtifacts artifacts: "artifacts/vm-${action}.json", allowEmptyArchive: false
                            if (params.ACTION == 'apply') {
                                timeout(time: 10, unit: 'MINUTES') {
                                    input message: "Review vm-plan.json for VM changes, disk capacity and replacement intent and revision ${env.PLATFORM_REVISION}. Apply this plan?", ok: 'Apply reviewed plan', submitter: 'whtan'
                                }
                                def current = checkout scm
                                if (current.GIT_COMMIT != env.PLATFORM_REVISION) {
                                    error('main changed during review; start a new plan.')
                                }
                                withEnv(["PLATFORM_ACTION=apply", "VM_REPLACE_OS=${params.REPLACE_OS}"]) {
                                    sh './scripts/ci/run-vm.sh'
                                }
                                archiveArtifacts artifacts: 'artifacts/vm-apply.json', allowEmptyArchive: false
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.PLATFORM_PRIVATE) {
                    dir(env.PLATFORM_PRIVATE) { deleteDir() }
                }
            }
        }
    }
}
