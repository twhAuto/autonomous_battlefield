# Generated by scripts/cd/setup-environment.sh; literal KEY=value, never shell syntax.
# Store outside Git at ~/.config/autonomous-battlefield/dev/deployment.env.
BF_ENV=dev
BF_CONTEXT=battlefield-dev
BF_CLUSTER=battlefield
BF_UID=REPLACE_WITH_KUBE_SYSTEM_NAMESPACE_UID
BF_DOCKER_HOST=unix:///var/run/docker.sock
BF_URL=http://battlefield.localhost:8888
BF_KUBECONFIG=kubeconfig
# Set to 1 only for a deliberately disposable DEV cluster used for failure drills.
BF_DISPOSABLE=0
# Production tunnel settings; paths are relative to this file.
# BF_TUNNEL_ID=replace-with-tunnel-uuid
# BF_TUNNEL_CREDENTIALS_FILE=tunnel-credentials.json
# BF_TUNNEL_IMAGE=cloudflare/cloudflared@sha256:replace-with-verified-digest
# Required for production observability; approved CA/serving certificates with valid node IP SANs.
# BF_KUBELET_CA_FILE=kubelet-ca.crt
