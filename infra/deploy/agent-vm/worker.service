[Unit]
Description=Isolated Battlefield CLI worker
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/battlefield-agent/worker.env
ConditionPathExists=/etc/battlefield-agent/config.yaml

[Service]
User=battlefield-worker
Group=battlefield-worker
WorkingDirectory=/var/lib/battlefield-worker
EnvironmentFile=/etc/battlefield-agent/worker.env
Environment=HOME=/var/lib/battlefield-worker
Environment=HTTPS_PROXY=http://192.168.234.1:3128
Environment=HTTP_PROXY=http://192.168.234.1:3128
Environment=NO_PROXY=192.168.234.1,127.0.0.1,localhost
ExecStart=/usr/local/bin/battlefield-agent -config /etc/battlefield-agent/config.yaml
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/battlefield-worker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET
CapabilityBoundingSet=
UMask=0077
MemoryMax=3G
TasksMax=256
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
