[Unit]
Description=Battlefield CLI VM host firewall
Before=squid.service battlefield-mcp-proxy.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/nft --file /etc/battlefield-agent/firewall.nft
ExecReload=/usr/sbin/nft --file /etc/battlefield-agent/firewall.nft
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
