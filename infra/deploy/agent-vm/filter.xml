<filter name='battlefield-agent' chain='root'>
  <filterref filter='clean-traffic'/>
  <rule action='accept' direction='inout' priority='100'><arp/></rule>
  <rule action='accept' direction='in' priority='110'><tcp srcipaddr='192.168.234.1' dstportstart='22'/></rule>
  <rule action='accept' direction='out' priority='110'><tcp dstipaddr='192.168.234.1' srcportstart='22' state='ESTABLISHED'/></rule>
  <rule action='accept' direction='out' priority='120'><tcp dstipaddr='192.168.234.1' dstportstart='3128'/></rule>
  <rule action='accept' direction='out' priority='120'><tcp dstipaddr='192.168.234.1' dstportstart='18084'/></rule>
  <rule action='accept' direction='in' priority='130'><tcp srcipaddr='192.168.234.1' srcportstart='3128' state='ESTABLISHED'/></rule>
  <rule action='accept' direction='in' priority='130'><tcp srcipaddr='192.168.234.1' srcportstart='18084' state='ESTABLISHED'/></rule>
  <rule action='drop' direction='inout' priority='900'><all/></rule>
  <rule action='drop' direction='inout' priority='900'><all-ipv6/></rule>
</filter>
