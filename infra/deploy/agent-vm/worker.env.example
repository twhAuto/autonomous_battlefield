# root:root 0400 inside the VM; systemd reads it before dropping privileges.
# Same worker control secret as the private AI gateway, NEVER the capability-signing secret.
BATTLEFIELD_AGENT_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_32_BYTE_SECRET
BATTLEFIELD_ENV=production
# Set only after host and guest isolation checks and load testing are recorded.
BATTLEFIELD_CLI_ISOLATION_VERIFIED=true
