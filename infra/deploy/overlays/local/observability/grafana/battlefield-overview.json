          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "1 - ((sum(increase(battlefield_http_server_request_duration_seconds_count{component=\"api\",outcome=\"success\"}[30d])) - sum(increase(battlefield_http_server_request_duration_seconds_bucket{component=\"api\",outcome=\"success\",le=\"0.5\"}[30d]))) / clamp_min(sum(increase(battlefield_http_server_request_duration_seconds_count{component=\"api\",outcome=\"success\"}[30d])), 1))",
          "instant": true,
          "legendFormat": "Under 500 ms",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API latency SLI (30d / 95%)",
      "type": "stat",
      "description": "Share of successfully served requests completing under 500 ms. Error responses are excluded so a fast 5xx cannot read as a fast success."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "battlefield-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
