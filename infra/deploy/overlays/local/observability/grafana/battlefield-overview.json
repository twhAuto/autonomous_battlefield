  "description": "Golden signals and proposed service-level objectives for Autonomous Battlefield.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "battlefield-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.999
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "1 - ((sum(increase(battlefield_http_server_requests_total{component=\"api\",code=~\"5..\"}[30d])) or vector(0)) / clamp_min(sum(increase(battlefield_http_server_requests_total{component=\"api\"}[30d])), 1))",
          "instant": true,
          "legendFormat": "Availability",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "API availability SLI (30d / 99.9%)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "battlefield-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
