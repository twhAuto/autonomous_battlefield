      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "1 - ((sum(increase(battlefield_engine_battles_processed_total{component=\"engine\",outcome=~\"failed|error|lease_lost\"}[30d])) or vector(0)) / clamp_min(sum(increase(battlefield_engine_battles_processed_total{component=\"engine\",outcome=~\"completed|failed|error|lease_lost\"}[30d])), 1))",
          "instant": true,
          "legendFormat": "Success",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Battle processing SLI (30d / 99%)",
      "type": "stat",
      "description": "Share of completed, failed, error and lease-lost processing attempts that did not fail. Graceful-shutdown requeues are excluded: ownership was handed back safely, and counting them as successes would raise the ratio."
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "battlefield-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
