      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(clamp_min(sum by (target) (label_replace(kube_deployment_spec_replicas{namespace=\"battlefield\",deployment=~\"battlefield-(api|engine)\"}, \"target\", \"$1\", \"deployment\", \"battlefield-(.*)\")) - sum by (target) (label_replace(up{job=\"battlefield-pods\",component=~\"api|engine\"} == 1, \"target\", \"$1\", \"component\", \"(.*)\")) or sum by (target) (label_replace(kube_deployment_spec_replicas{namespace=\"battlefield\",deployment=~\"battlefield-(api|engine)\"}, \"target\", \"$1\", \"deployment\", \"battlefield-(.*)\")), 0))",
          "instant": true,
          "legendFormat": "Missing targets",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Missing API and engine targets",
      "type": "stat",
      "description": "API and engine replicas their Deployments expect that have no healthy metrics target: a replica that is down, not yet Running or cannot be scraped. Each component is counted separately, so extra API pods during a rollout cannot hide a missing engine. Shows no data while kube-state-metrics is unavailable."
    },
