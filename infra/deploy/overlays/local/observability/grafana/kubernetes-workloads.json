        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "kube_deployment_status_replicas_available{namespace=\"battlefield\"} / clamp_min(kube_deployment_spec_replicas{namespace=\"battlefield\"}, 1)",
          "legendFormat": "{{deployment}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Deployment replica availability",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
