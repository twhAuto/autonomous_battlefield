            "axisColorMode": "text",
            "axisLabel": "Memory",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
