          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_receive_bytes_total{namespace=\"battlefield\",pod!=\"\"}[5m]))",
          "legendFormat": "{{pod}} receive",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_network_transmit_bytes_total{namespace=\"battlefield\",pod!=\"\"}[5m]))",
          "legendFormat": "{{pod}} transmit",
