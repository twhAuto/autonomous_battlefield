# Admission-policy template rendered by apply-kyverno-policy.sh with image repositories
# and a public key; requires signatures and build attestations.

apiVersion: kyverno.io/v1
kind: ClusterPolicy
metadata:
  name: battlefield-verified-images
spec:
  admission: true
  background: false
  validationFailureAction: Enforce
  webhookConfiguration:
    failurePolicy: Fail
    timeoutSeconds: 30
  rules:
    - name: verify-battlefield-images
      match:
        any:
          - resources:
              kinds: [Pod]
              namespaces: [battlefield]
      verifyImages:
        - imageReferences:
            - "__BACKEND_IMAGE_REPOSITORY__:*"
            - "__BACKEND_IMAGE_REPOSITORY__@sha256:*"
            - "__FRONTEND_IMAGE_REPOSITORY__:*"
            - "__FRONTEND_IMAGE_REPOSITORY__@sha256:*"
          required: true
          mutateDigest: true
          verifyDigest: true
          imageRegistryCredentials:
            secrets:
              - battlefield-ghcr
          attestors:
            - entries:
                - keys:
                    publicKeys: |-
                      __COSIGN_PUBLIC_KEY__
          attestations:
            - type: https://cyclonedx.org/bom
              attestors:
                - entries:
                    - keys:
                        publicKeys: |-
                          __COSIGN_PUBLIC_KEY__
            - type: https://slsa.dev/provenance/v0.2
              attestors:
                - entries:
                    - keys:
                        publicKeys: |-
                          __COSIGN_PUBLIC_KEY__
            - type: https://autonomous-battlefield.dev/attestations/ai-manifest/v1
              attestors:
                - entries:
                    - keys:
                        publicKeys: |-
                          __COSIGN_PUBLIC_KEY__
