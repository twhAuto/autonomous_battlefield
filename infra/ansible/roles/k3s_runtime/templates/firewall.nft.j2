# This transaction owns only the guest's battlefield_k3s table.
add table inet battlefield_k3s
flush table inet battlefield_k3s
table inet battlefield_k3s {
 chain private_ports {
  type filter hook prerouting priority -110; policy accept;
  # Check NodePorts before kube-proxy DNAT moves packets to the forward hook.
  ip daddr {{ k3s_contract.guest_ip }} ip saddr != { {{ k3s_contract.host_ip }}, {{ k3s_contract.guest_ip }}, {{ k3s_contract.pod_cidr }} } tcp dport { 22, 6443, 10250, 30000-32767 } drop
  ip daddr {{ k3s_contract.guest_ip }} ip saddr != { {{ k3s_contract.host_ip }}, {{ k3s_contract.guest_ip }}, {{ k3s_contract.pod_cidr }} } udp dport { 8472, 30000-32767 } drop
 }
 chain input {
  type filter hook input priority -10; policy accept;
  iifname "lo" accept
  ct state established,related accept
  ip saddr { {{ k3s_contract.host_ip }}, {{ k3s_contract.guest_ip }}, {{ k3s_contract.pod_cidr }} } accept
  tcp dport { 22, 6443, 10250, 30000-32767 } drop
  udp dport { 8472, 30000-32767 } drop
 }
}
