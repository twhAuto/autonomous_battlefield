# Existing Compose project and volume names are retained during adoption.
name: sonarqube
services:
  sonarqube:
    image: {{ ci_lock.sonarqube }}
    restart: unless-stopped
    depends_on:
      database:
        condition: service_healthy
    environment:
      SONAR_JDBC_URL: jdbc:postgresql://database:5432/sonar
      SONAR_JDBC_USERNAME: sonar
    ports:
      - "127.0.0.1:9000:9000"
    stop_grace_period: 1h
    volumes:
      - sonarqube_data:/opt/sonarqube/data
      - sonarqube_extensions:/opt/sonarqube/extensions
      - sonarqube_logs:/opt/sonarqube/logs
  database:
    image: {{ ci_lock.postgres }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: sonar
      POSTGRES_USER: sonar
    healthcheck:
      test: [CMD-SHELL, pg_isready -U sonar -d sonar]
      interval: 10s
      timeout: 5s
      retries: 10
    volumes:
      - sonarqube_database:/var/lib/postgresql/data
volumes:
  sonarqube_data:
  sonarqube_extensions:
  sonarqube_logs:
  sonarqube_database:
