// AB-139/AB-162: keep the registered CLI worker running and in sync with production.
pipeline {
    agent { label 'battlefield-production' }
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
    }
    parameters {
        choice(name: 'ACTION', choices: ['verify', 'plan', 'apply'], description: 'verify only reads. apply creates a fresh plan and pauses for owner review before repairing the CLI VM, bridge or worker.')
    }
    stages {
        stage('Trusted checkout') {
            steps {
                script {
                    if (env.JOB_NAME != 'battlefield-platform/cli' || env.CHANGE_ID) {
                        error('Run this entry point only in the seeded platform CLI job.')
                    }
                    deleteDir()
                    def source = checkout scm
                    env.PLATFORM_REVISION = source.GIT_COMMIT
                    env.PLATFORM_PRIVATE = "${pwd(tmp: true)}/platform-${env.BUILD_NUMBER}"
                    sh 'umask 077; mkdir -p "$PLATFORM_PRIVATE"'
                }
            }
        }
        stage('CLI worker operation') {
            steps {
                // Same resource as the main production rollout, so repairs never overlap a deployment.
                lock(resource: 'battlefield-production-platform') {
                    withCredentials([file(credentialsId: 'host-sudo-password', variable: 'PLATFORM_SUDO_PASSWORD')]) {
                        script {
                            def action = params.ACTION == 'verify' ? 'verify' : 'plan'
                            withEnv(["PLATFORM_ACTION=${action}"]) {
                                sh './scripts/ci/run-cli-worker.sh'
                            }
                            archiveArtifacts artifacts: "artifacts/cli-${action}.json", allowEmptyArchive: false
                            if (params.ACTION == 'apply') {
                                timeout(time: 10, unit: 'MINUTES') {
                                    input message: "Review cli-plan.json repairs and revision ${env.PLATFORM_REVISION}. Apply this plan?", ok: 'Apply reviewed plan', submitter: 'whtan'
                                }
                                def current = checkout scm
                                if (current.GIT_COMMIT != env.PLATFORM_REVISION) {
                                    error('main changed during review; start a new plan.')
                                }
                                withEnv(['PLATFORM_ACTION=apply']) {
                                    sh './scripts/ci/run-cli-worker.sh'
                                }
                                archiveArtifacts artifacts: 'artifacts/cli-apply.json', allowEmptyArchive: false
                            }
                        }
                    }
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.PLATFORM_PRIVATE) {
                    dir(env.PLATFORM_PRIVATE) { deleteDir() }
                }
            }
        }
    }
}
