# Shared application schema for dev and production; use separate credentials.
# Dev: root .env (initialize with ./scripts/cd/prepare-dev-secrets.sh).
# Production: ~/.config/autonomous-battlefield/production/.env.
# Literal KEY=value format. Do not quote values or use shell expansion.
# Edit dev .env then ./scripts/cd/deploy-local.sh. Production uses the verified Jenkins pipeline.
# Never put deployment BF_* settings here; they belong in deployment.env.

# Database: preserve the password belonging to any existing PostgreSQL database.
POSTGRES_DB=battlefield
POSTGRES_USER=battlefield
POSTGRES_PASSWORD=replace-with-existing-or-generated-password
DATABASE_URL=postgres://battlefield:replace-with-existing-or-generated-password@battlefield-postgres:5432/battlefield?sslmode=disable
# Optional dedicated AI gateway login; defaults to DATABASE_URL when absent. The
# pre-rename name MCP_DATABASE_URL is still accepted.
# AI_GATEWAY_DATABASE_URL=postgres://ai-gateway-user:password@battlefield-postgres:5432/battlefield?sslmode=disable

# Dev authentication. For no login use disabled-development and AUTH_ENABLED=false.
BATTLEFIELD_AUTH_MODE=local-password
BATTLEFIELD_AUTH_ENABLED=true
BATTLEFIELD_ADMIN_USERNAME=admin
BATTLEFIELD_ADMIN_PASSWORD=replace-with-at-least-12-characters
BATTLEFIELD_SESSION_SECRET=replace-with-at-least-32-random-characters
BATTLEFIELD_AUTH_COOKIE_SECURE=false
# Production: replace AUTH_MODE above with cloudflare; AUTH_ENABLED stays true.
# Local admin username/password/session values may be removed in Cloudflare mode.
# BATTLEFIELD_ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# BATTLEFIELD_ACCESS_AUDIENCE=replace-with-64-character-audience
# BATTLEFIELD_PUBLIC_ORIGIN=https://play.example.com
# Optional CI service identity: Client ID only, never the Client Secret.
# BATTLEFIELD_ACCESS_CI_CLIENT_ID=
# BATTLEFIELD_ACCESS_ROLES={"admin":["owner@example.com"],"tester":[],"player":[]}

# Independent worker and MCP capability credentials, each at least 32 bytes.
BATTLEFIELD_AGENT_SECRET=replace-with-at-least-32-random-characters
BATTLEFIELD_MCP_CAPABILITY_SECRET=replace-with-at-least-32-random-characters
# Providers: enable only with a key and model. CLI profiles require host setup.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_PROFILE_AVAILABLE=false
GEMINI_PROFILE_AVAILABLE=false
ANTHROPIC_PROFILE_AVAILABLE=false
CODEX_CLI_PROFILE_AVAILABLE=false
# Enables the Antigravity CLI profile; the name predates the move from Gemini CLI.
GEMINI_CLI_PROFILE_AVAILABLE=false
CLAUDE_CLI_PROFILE_AVAILABLE=false
BATTLEFIELD_CLI_ISOLATION_VERIFIED=false

# Optional application integrations; these values reach backend pods.
# BATTLEFIELD_REDIS_URL=redis://redis:6379/0
# LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://battlefield-otel-collector:4318
OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://battlefield-otel-collector:4318/v1/traces
# LANGFUSE_BASE_URL=http://langfuse.localhost:8888
# LANGFUSE_PROJECT_ID=battlefield-agents

# Optional API-only Player invitation management. Enable after dedicated Cloudflare setup.
BATTLEFIELD_MANAGED_PLAYERS=false
# BATTLEFIELD_MEMBERS_ACCOUNT_ID=0123456789abcdef0123456789abcdef
# BATTLEFIELD_MEMBERS_GROUP_ID=00000000-0000-0000-0000-000000000000
# BATTLEFIELD_MEMBERS_API_TOKEN=private-account-scoped-token
