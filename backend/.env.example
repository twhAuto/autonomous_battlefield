# Example environment overrides for local backend processes; copy values into the private
# local environment described in the setup guide.

BATTLEFIELD_POSTGRES_PASSWORD=replace-with-a-url-safe-random-value
DATABASE_URL=
BATTLEFIELD_AUTH_ENABLED=false
BATTLEFIELD_ADMIN_USERNAME=
BATTLEFIELD_ADMIN_PASSWORD=
BATTLEFIELD_SESSION_SECRET=
BATTLEFIELD_AUTH_COOKIE_SECURE=false
BATTLEFIELD_MCP_CAPABILITY_SECRET=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Worker control credential: generate independently of the MCP signing key.
BATTLEFIELD_AGENT_SECRET=
BATTLEFIELD_AUTH_MODE=disabled-development
BATTLEFIELD_ENV=dev
