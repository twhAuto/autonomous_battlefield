# Copy to auth-secret.env, replace every placeholder, and create the optional
# battlefield-auth Kubernetes Secret as described in docs/operations/deployment.md.
BATTLEFIELD_AUTH_ENABLED=true
BATTLEFIELD_ADMIN_USERNAME=admin
BATTLEFIELD_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BATTLEFIELD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep false for the local HTTP gateway; set true for Cloudflare Tunnel or any
# HTTPS deployment. Reapply this Secret and restart battlefield-api after changing it.
BATTLEFIELD_AUTH_COOKIE_SECURE=false
