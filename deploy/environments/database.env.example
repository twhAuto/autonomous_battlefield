# Reference only. Run scripts/cd/prepare-dev-secrets.sh after registering dev.
# It preserves existing database credentials in the private dev database.env file
# selected by BF_DATABASE_FILE. Do not overwrite existing credentials with this example.
# See docs/operations/environments.md. These example values are development-only.
POSTGRES_DB=battlefield
POSTGRES_USER=battlefield
POSTGRES_PASSWORD=battlefield
DATABASE_URL=postgres://battlefield:battlefield@battlefield-postgres:5432/battlefield?sslmode=disable
# Production should use a login granted only the battlefield_mcp role. The
# disposable local cluster reuses its development owner for simple bootstrap.
MCP_DATABASE_URL=postgres://battlefield:battlefield@battlefield-postgres:5432/battlefield?sslmode=disable
