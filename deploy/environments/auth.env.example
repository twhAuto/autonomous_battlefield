# Reference only. Run scripts/cd/prepare-dev-secrets.sh after registering dev.
# Edit ~/.config/autonomous-battlefield/dev/auth.env (or BF_AUTH_FILE in your
# registered profile), then run ./deploy-local.sh. Do not copy this beside the template.
# See docs/operations/environments.md for dev setup and production credentials.
BATTLEFIELD_AUTH_ENABLED=true
BATTLEFIELD_ADMIN_USERNAME=admin
BATTLEFIELD_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BATTLEFIELD_SESSION_SECRET=replace-with-at-least-32-random-characters
# Keep false for the local HTTP gateway. Production uses Cloudflare mode,
# which issues no application authentication cookie. Reapply this Secret and restart battlefield-api after changing it.
BATTLEFIELD_AUTH_COOKIE_SECURE=false

BATTLEFIELD_AUTH_MODE=local-password
# Production uses cloudflare and requires these values instead of a password:
# BATTLEFIELD_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
# BATTLEFIELD_ACCESS_AUDIENCE=YOUR-APPLICATION-AUD
# BATTLEFIELD_PUBLIC_ORIGIN=https://battlefield.example.com
# BATTLEFIELD_ACCESS_ROLES={"admin":["owner@example.com"],"developer":[],"player":[]}
