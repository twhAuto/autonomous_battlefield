# Generated by scripts/cd/setup-environment.sh; trusted shell syntax.
# Store outside Git at ~/.config/autonomous-battlefield/dev/environment.env.
BF_ENV=dev
BF_CONTEXT=battlefield-dev
BF_CLUSTER=battlefield
BF_UID=REPLACE_WITH_KUBE_SYSTEM_NAMESPACE_UID
BF_DOCKER_HOST=unix:///var/run/docker.sock
BF_URL=http://battlefield.localhost:8888
BF_KUBECONFIG=/absolute/private/path/kubeconfig
BF_DATABASE_FILE=/absolute/private/path/database.env
BF_AI_FILE=/absolute/private/path/ai.env
BF_AUTH_FILE=/absolute/private/path/auth.env
# Set to 1 only for a deliberately disposable DEV cluster used for failure drills.
BF_DISPOSABLE=0
